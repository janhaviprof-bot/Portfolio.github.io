    {
      "parameters": {
        "jsCode": "const DAY_MS = 24 * 60 * 60 * 1000;\nconst cutoff = Date.now() - DAY_MS;\n\nfunction clean(value) {\n  return String(value || '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction stripHtml(html) {\n  return clean(String(html || '').replace(/<[^>]+>/g, ' '));\n}\n\nfunction isEnabled(value) {\n  return value === true || value === 1 || ['true', '1', 'yes', 'y'].includes(clean(value).toLowerCase());\n}\n\nfunction getConfigValue(rows, key) {\n  const row = rows.find((item) => clean(item.json.key).toLowerCase() === key);\n  return clean(row?.json.value || '');\n}\n\nfunction splitTerms(value) {\n  return clean(value)\n    .split(/[,;|\\n]/)\n    .map((term) => clean(term).toLowerCase())\n    .filter(Boolean);\n}\n\nfunction deriveGreenhouseSlug(row) {\n  if (clean(row.slug)) return clean(row.slug);\n\n  const url = clean(row.career_page_url || row.endpoint);\n  if (!url) return '';\n\n  try {\n    const parsed = new URL(url);\n    const parts = parsed.pathname.split('/').filter(Boolean);\n\n    if (parsed.hostname.includes('boards-api.greenhouse.io')) {\n      return parts[1] || parts[0] || '';\n    }\n\n    return parts[0] || '';\n  } catch (error) {\n    return '';\n  }\n}\n\nfunction isGreenhouseRow(row) {\n  const atsType = clean(row.ats_type).toLowerCase();\n  const url = clean(row.career_page_url || row.endpoint).toLowerCase();\n  return atsType === 'greenhouse' || url.includes('greenhouse.io');\n}\n\nfunction matchesRole(title, terms) {\n  const normalizedTitle = clean(title).toLowerCase();\n  return terms.some((term) => normalizedTitle.includes(term));\n}\n\nfunction getJobUrl(job) {\n  return clean(job.absolute_url || job.url || '');\n}\n\nconst configRows = $('Read config tab').all();\nconst companies = $input.all().map((item) => item.json);\n\nconst roleTerms = [\n  ...splitTerms(getConfigValue(configRows, 'systems_title_references')),\n  ...splitTerms(getConfigValue(configRows, 'mechanical_title_references')),\n  ...splitTerms(getConfigValue(configRows, 'controls_title_references')),\n];\n\nconst terms = roleTerms.length\n  ? [...new Set(roleTerms)]\n  : ['systems engineer', 'system engineer', 'mechanical engineer', 'controls engineer', 'control systems engineer'];\n\nconst out = [];\n\nfor (const companyRow of companies) {\n  if (!isEnabled(companyRow.enabled)) continue;\n  if (!isGreenhouseRow(companyRow)) continue;\n\n  const slug = deriveGreenhouseSlug(companyRow);\n  if (!slug) continue;\n\n  const company = clean(companyRow.company) || slug;\n  const apiUrl = `https://boards-api.greenhouse.io/v1/boards/${encodeURIComponent(slug)}/jobs?content=true`;\n\n  let response;\n  try {\n    response = await $helpers.httpRequest({ method: 'GET', url: apiUrl, json: true });\n  } catch (error) {\n    out.push({\n      json: {\n        title: `Greenhouse fetch failed: ${company}`,\n        company,\n        location: '',\n        apply_url: '',\n        discovery_url: apiUrl,\n        posted_at: '',\n        needs_manual_jd: true,\n        full_jd: clean(error.message || error),\n        status: 'fetch_error',\n        source: 'greenhouse',\n        bucket_selected: '',\n        score: '',\n        rank_reason: '',\n      },\n    });\n    continue;\n  }\n\n  const jobs = Array.isArray(response.jobs) ? response.jobs : [];\n\n  for (const job of jobs) {\n    const updatedAt = job.updated_at ? new Date(job.updated_at).getTime() : 0;\n    if (!updatedAt || updatedAt < cutoff) continue;\n    if (!matchesRole(job.title, terms)) continue;\n\n    const fullJd = stripHtml(job.content || '');\n    const url = getJobUrl(job);\n\n    out.push({\n      json: {\n        title: clean(job.title),\n        company,\n        location: clean(job.location?.name),\n        apply_url: url,\n        discovery_url: url,\n        posted_at: clean(job.updated_at),\n        needs_manual_jd: !fullJd,\n        full_jd: fullJd,\n        status: fullJd ? 'ready' : 'needs_jd',\n        source: 'greenhouse',\n        bucket_selected: '',\n        score: '',\n        rank_reason: '',\n      },\n    });\n  }\n}\n\nreturn out;"
      },
      "id": "3e2d1b8d-ec17-4f1b-9ed1-8b5c0b2ef005",
      "name": "Fetch Greenhouse jobs",
