      "name": "Read existing jobs tab",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        980,
        -760
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "47TfMO6C0R1sbaT0",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function clean(value) {\n  return String(value || '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction normalizeUrl(value) {\n  return clean(value)\n    .toLowerCase()\n    .replace(/^https?:\\/\\//, '')\n    .replace(/^www\\./, '')\n    .replace(/[?#].*$/, '')\n    .replace(/\\/+$/, '');\n}\n\nfunction normalizeText(value) {\n  return clean(value)\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, ' ')\n    .trim();\n}\n\nfunction makeCompanyTitleKey(row) {\n  const company = normalizeText(row.company);\n  const title = normalizeText(row.title);\n  return company && title ? `${company}|${title}` : '';\n}\n\nconst newJobs = $input.all();\n\nlet existingRows = [];\ntry {\n  existingRows = $('Read existing jobs tab').all();\n} catch (error) {\n  existingRows = [];\n}\n\nconst seenUrls = new Set();\nconst seenCompanyTitle = new Set();\n\nfor (const item of existingRows) {\n  const row = item.json || {};\n\n  const existingUrl = normalizeUrl(row.discovery_url || row.apply_url);\n  if (existingUrl) seenUrls.add(existingUrl);\n\n  const existingCompanyTitle = makeCompanyTitleKey(row);\n  if (existingCompanyTitle) seenCompanyTitle.add(existingCompanyTitle);\n}\n\nconst out = [];\n\nfor (const item of newJobs) {\n  const job = item.json || {};\n\n  const jobUrl = normalizeUrl(job.discovery_url || job.apply_url);\n  const jobCompanyTitle = makeCompanyTitleKey(job);\n\n  if (jobUrl && seenUrls.has(jobUrl)) continue;\n  if (jobCompanyTitle && seenCompanyTitle.has(jobCompanyTitle)) continue;\n\n  if (jobUrl) seenUrls.add(jobUrl);\n  if (jobCompanyTitle) seenCompanyTitle.add(jobCompanyTitle);\n\n  out.push(item);\n}\n\nreturn out;"
      },
