# Copy to .env and fill in. Do not commit .env

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Public URL (required for OAuth callbacks on VPS)
# WEBHOOK_URL=https://n8n.yourdomain.com/

# Google Sheet (from URL: .../d/{SPREADSHEET_ID}/edit)
SPREADSHEET_ID=
SHEET_URL=

# Reminder after Workflow A (your email)
REMINDER_EMAIL=

# OpenAI — prefer n8n Credentials UI (Workflow B ranking). Optional here only if nodes read env.
# OPENAI_API_KEY=

# Optional: default SmartRecruiters search query
DEFAULT_SR_QUERY=systems engineer
