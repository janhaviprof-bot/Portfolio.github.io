e="0" noProof="0" dirty="0"><a:ln><a:noFill/></a:ln><a:solidFill><a:prstClr val="black"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Calibri" panose="020F0502020204030204"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="17" name="Text 14"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{0E024DFE-4EB5-E5EA-F576-65EC75796747}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="8046720" y="4280965"/><a:ext cx="3413760" cy="742139"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="171450" marR="0" lvl="0" indent="-171450" algn="l" defTabSz="1219170" rtl="0" eaLnBrk="1" fontAlgn="auto" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClrTx/><a:buSzTx/><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/><a:tabLst/><a:defRPr/></a:pPr><a:r><a:rPr kumimoji="0" lang="en-US" sz="1133" b="0" i="0" u="none" strike="noStrike" kern="1200" cap="none" spc="0" normalizeH="0" baseline="0" noProof="0" dirty="0"><a:ln><a:noFill/></a:ln><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Both show longer paths as clearance grows (3 m → 15 m); largest change is 3 m → 10 m; 10 m ≈ 15 m for most pairs.</a:t></a:r></a:p><a:p><a:pPr marL="171450" marR="0" lvl="0" indent="-171450" algn="l" defTabSz="1219170" rtl="0" eaLnBrk="1" fontAlgn="auto" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClrTx/><a:buSzTx/><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/><a:tabLst/><a:defRPr/></a:pPr><a:r><a:rPr kumimoji="0" lang="en-US" sz="1133" b="0" i="0" u="none" strike="noStrike" kern="1200" cap="none" spc="0" normalizeH="0" baseline="0" noProof="0" dirty="0"><a:ln><a:noFill/></a:ln><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>F2 (dashed) is consistently lower in total distance — on average ~20% shorter at 3 m, ~8% at 15 m (e.g. Pair 1: 527 m vs 387 m at 3 m).</a:t></a:r></a:p><a:p><a:pPr marL="171450" marR="0" lvl="0" indent="-171450" algn="l" defTabSz="1219170" rtl="0" eaLnBrk="1" fontAlgn="auto" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClrTx/><a:buSzTx/><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/><a:tabLst/><a:defRPr/></a:pPr><a:r><a:rPr kumimoji="0" lang="en-US" sz="1133" b="0" i="0" u="none" strike="noStrike" kern="1200" cap="none" spc="0" normalizeH="0" baseline="0" noProof="0" dirty="0"><a:ln><a:noFill/></a:ln><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Why F2 looks “shorter”: searches a fine 3D grid (1 m cells, 5 m vertical steps) — ~330–480 waypoints vs F1’s sparse corner graph (far fewer nodes). More sampling → closer to a geometric minimum in this model.</a:t></a:r></a:p><a:p><a:pPr marL="171450" marR="0" lvl="0" indent="-171450" algn="l" defTabSz="1219170" rtl="0" eaLnBrk="1" fontAlgn="auto" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClrTx/><a:buSzTx/><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/><a:tabLst/><a:defRPr/></a:pPr><a:r><a:rPr kumimoji="0" lang="en-US" sz="1133" b="0" i="0" u="none" strike="noStrike" kern="1200" cap="none" spc="0" normalizeH="0" baseline="0" noProof="0" dirty="0"><a:ln><a:noFill/></a:ln><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Not apples-to-apples: F1 uses cuboid NFZ; F2 uses raster buffer B — trends align, but absolute </a:t></a:r><a:r><a:rPr kumimoji="0" lang="en-US" sz="1133" b="0" i="0" u="none" strike="noStrike" kern="1200" cap="none" spc="0" normalizeH="0" baseline="0" noProof="0" dirty="0" err="1"><a:ln><a:noFill/></a:ln><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>metres</a:t></a:r><a:r><a:rPr kumimoji="0" lang="en-US" sz="1133" b="0" i="0" u="none" strike="noStrike" kern="1200" cap="none" spc="0" normalizeH="0" baseline="0" noProof="0" dirty="0"><a:ln><a:noFill/></a:ln><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typefac