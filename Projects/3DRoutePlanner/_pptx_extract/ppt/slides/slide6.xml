ffice/drawing/2014/main" id="{19C2E016-7824-A27F-40B2-1B85D5B549E4}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="8046720" y="4357636"/><a:ext cx="3413760" cy="665468"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="171450" indent="-171450" defTabSz="1219170"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>One cuboid per connected component: touching or 8-neighbor adjoined tall cells collapse into one tight bounding box.</a:t></a:r></a:p><a:p><a:pPr marL="171450" indent="-171450" defTabSz="1219170"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Flat roof: roof height is the maximum grid value in the cluster → no setbacks or stepped crowns inside the </a:t></a:r><a:r><a:rPr lang="en-US" sz="1200" dirty="0" err="1"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>bbox</a:t></a:r><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>.</a:t></a:r></a:p><a:p><a:pPr marL="171450" indent="-171450" defTabSz="1219170"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Integer grid indices: positions are discrete cell corners (int(</a:t></a:r><a:r><a:rPr lang="en-US" sz="1200" dirty="0" err="1"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>x_min</a:t></a:r><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>), …).</a:t></a:r></a:p><a:p><a:pPr marL="171450" indent="-171450" defTabSz="1219170"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>No sub-cell geometry: finer than one cell detail is lost.</a:t></a:r></a:p></p:txBody></p:sp></p:grpSp><p:sp><p:nvSpPr><p:cNvPr id="19" name="Text 14"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A5FC72F9-1AB1-FFD0-6EC2-28CCE1D7FEC3}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="788699" y="2006189"/><a:ext cx="5222693" cy="1291480"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="171450" indent="-171450" defTabSz="1219170"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1133" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Represent the city footprint as a 2D raster grid.</a:t></a:r></a:p><a:p><a:pPr marL="171450" indent="-171450" defTabSz="1219170"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1133" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Cells with height greater than zero indicate occupied building area; zero = open sky / ground-level space.</a:t></a:r></a:p><a:p><a:pPr marL="171450" indent="-171450" defTabSz="1219170"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1133" dirty="0"><a:solidFill><a:srgbClr val="7A9BB5"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>The city is approximated by a set of 3D axis-aligned cuboids, not meshes or footprints per cell.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3769127576"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>